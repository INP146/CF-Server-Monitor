{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@next/*": ["./src/frontend-next/*"]
    },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/frontend-next/**/*.ts",
    "src/frontend-next/**/*.tsx",
    "src/frontend-next/**/*.vue"
  ]
}
